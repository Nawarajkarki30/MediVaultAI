# ==============================================================================
# MediVault AI — Environment Variables Template (Phase 2A: Authentication)
# ==============================================================================

# Backend Configuration
PORT=5001
NODE_ENV=development
API_PREFIX=/api
APP_URL=http://localhost:5173

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4206,http://127.0.0.1:4206

# Database Configuration (Docker PostgreSQL 16)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medivault_dev
POSTGRES_PORT=5434
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/medivault_dev?schema=public

# Session & Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=medivault_dev_secret_key_needs_to_be_at_least_32_characters_long!
CSRF_SECRET=medivault_dev_csrf_secret_key_needs_to_be_at_least_32_characters!
TRUST_PROXY=false
SESSION_TTL_HOURS=72
VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=1

# Rate Limiting Hardening (Phase 2C.4)
UPLOAD_RATE_LIMIT_USER_MAX=10
UPLOAD_RATE_LIMIT_IP_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=900000

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:5001/api

# Vault Storage & Cryptography (Phase 2C.3)
VAULT_STORAGE_ROOT=./storage_vault
VAULT_MASTER_KEY=d61eac7e0b0b6372dd0a5695a9b0f1d2ca043abc44daf82e46737d7ff6992c13
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
MAX_FILE_SIZE_BYTES=10485760
PATIENT_QUOTA_BYTES=104857600
MAX_CONCURRENT_CRYPTO_OPS=5
UPLOAD_REQUEST_TIMEOUT_MS=30000

