# ==============================================================================
# MediVault AI — Environment Variables Template (Phase 2A: Authentication)
# ==============================================================================

# Backend Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api
APP_URL=http://localhost:5173

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4206,http://127.0.0.1:4206

# Database Connection (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medivault_dev?schema=public

# Session & Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=medivault_dev_secret_key_needs_to_be_at_least_32_characters_long!
SESSION_TTL_HOURS=72
VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=1

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:5000/api
